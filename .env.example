# Supabase Database Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Groq Cloud API (Required for LLM models)
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# AI/LLM API Keys (Optional)
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Ollama Configuration (Optional - for local models as fallback)
# If running Ollama locally, default is http://localhost:11434
# Set this if Ollama is running on a different host/port
OLLAMA_HOST=http://localhost:11434

# Default Model Selection (Groq Cloud Models)
# Fast & balanced options:
# - llama-3.1-8b (recommended, fastest)
# - llama-3.2-3b (lightweight)
# - gemma2-9b (Google's model)
# - qwen-2.5-7b (multilingual)
# High-quality options:
# - llama-3.3-70b (best quality)
# - mixtral-8x7b (Mistral's best)
# - qwen-2.5-72b (most capable)
DEFAULT_LLM_MODEL=llama-3.1-8b

# Default Vision Model for Chart Analysis (Groq Cloud)
# Options: llama-3.2-11b-vision, llama-3.2-90b-vision
DEFAULT_VISION_MODEL=llama-3.2-11b-vision
