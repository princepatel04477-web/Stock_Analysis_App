# Frontend Environment Variables

# Supabase Configuration (REQUIRED for auth and DB features)
# Get these from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend API Configuration
# On Vercel: automatically /api (same domain, routed via Next.js API routes)
# In development: use localhost:3000/api for local dev
NEXT_PUBLIC_API_URL=/api

# Backend Supabase Configuration (for backend/.env if using Python backend)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Groq Cloud API (Required for LLM models)
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# AI/LLM API Keys (Optional)
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Ollama Configuration (Optional - for local models as fallback)
OLLAMA_HOST=http://localhost:11434

# Default Model Selection (Groq Cloud Models)
# Fast & balanced: llama-3.1-8b (recommended), llama-3.2-3b, gemma2-9b
# High-quality: llama-3.3-70b, mixtral-8x7b
DEFAULT_LLM_MODEL=llama-3.1-8b

# Default Vision Model for Chart Analysis
DEFAULT_VISION_MODEL=llama-3.2-11b-vision

# Deployment Platform: Vercel
# All services (frontend + backend) run on Vercel serverless
NODE_ENV=production
